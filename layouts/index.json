{{- $pages := where .Site.RegularPages "Section" "posts" -}}
[
{{- range $index, $page := $pages -}}
  {{- if $index }},{{ end }}
  {
    "objectID": "{{ $page.File.UniqueID }}",
    "title": {{ $page.Title | jsonify }},
    "url": "{{ $page.Permalink }}",
    "uri": "{{ $page.RelPermalink }}",
    "date": "{{ $page.Date.Format "2006-01-02T15:04:05Z07:00" }}",
    "description": {{ with $page.Description }}{{ . | jsonify }}{{ else }}{{ $page.Summary | plainify | truncate 200 | jsonify }}{{ end }},
    "content": {{ $page.Plain | plainify | truncate 2000 | jsonify }},
    "categories": {{ $page.Params.categories | jsonify }},
    "tags": {{ $page.Params.tags | jsonify }},
    "cover": {{ with $page.Params.cover }}{{ . | jsonify }}{{ else }}""{{ end }}
  }
{{- end }}
]